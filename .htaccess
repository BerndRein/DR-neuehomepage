# Derya Rein – Einstellungen für den Apache-Server bei STRATO

RewriteEngine On

# Immer HTTPS und ohne www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://derya-rein.de%{REQUEST_URI} [L,R=301,NE]

# Alte WordPress-Adressen dauerhaft auf die neue Seite umleiten
RewriteRule ^kontakt/?$ /#kontakt [L,R=301,NE]
RewriteRule ^angebot/?$ /#wege [L,R=301,NE]
RewriteRule ^termine/?$ /#wege [L,R=301,NE]
RewriteRule ^profil/?$ /#ueber-mich [L,R=301,NE]
RewriteRule ^impressum/?$ /impressum.html [L,R=301]
RewriteRule ^datenschutzerklaerung/?$ /datenschutz.html [L,R=301]
RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
RewriteRule ^(wp-sitemap.*\.xml|sitemap_index\.xml)$ /sitemap.xml [L,R=301]

# Eigene Fehlerseite
ErrorDocument 404 /404.html

# Schneller laden: Bilder und Schriften lange zwischenspeichern
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
</IfModule>
